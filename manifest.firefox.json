{
  "manifest_version": 2,
  "name": "TidyTabs",
  "version": "1.2.0",
  "description": "AI-powered tab organization using OpenRouter. Group your tabs intelligently with full control over prompts and behavior.",
  "browser_specific_settings": {
    "gecko": {
      "id": "support@novatra.in"
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "contextMenus",
    "notifications",
    "https://openrouter.ai/*"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "96": "icons/icon96.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TidyTabs - Organize your tabs"
  },
  "options_page": "options.html",
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Open TidyTabs popup"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    "icons/*"
  ]
}
